#!/usr/bin/env bash
# sync-dji — Importa fotos DJI do celular para ~/etc/wallpapers/
# Nunca reimporta arquivos excluídos manualmente (via kill-wallpaper).

WALLPAPER_DIR="$HOME/etc/wallpapers"
STATE_DIR="$HOME/.local/share/dji-sync"
BLACKLIST="$STATE_DIR/deleted.txt"

MTP_BASE="mtp://motorola_moto_g86_5G_ZY32M35GDZ"
MTP_PATH="$MTP_BASE/Armazenamento%20interno%20compartilhado/DCIM/DJI%20Album"

mkdir -p "$STATE_DIR" "$WALLPAPER_DIR"

echo "Conectando ao celular..."

if ! gio list "$MTP_PATH/" &>/dev/null; then
    echo ""
    echo "ERRO: dispositivo MTP nao encontrado."
    echo "Conecte o celular e desbloqueie a tela."
    echo ""
    read -rsp "Pressione Enter para fechar..." _
    exit 1
fi

echo "Lendo DJI Album..."
echo ""

declare -A blacklisted
if [[ -f "$BLACKLIST" ]]; then
    while IFS= read -r name; do
        [[ -n "$name" ]] && blacklisted["$name"]=1
    done < "$BLACKLIST"
fi

copied=0
skipped_exists=0
skipped_blacklist=0
errors=0

while IFS= read -r filename; do
    [[ -z "$filename" ]] && continue
    [[ "$filename" =~ \.(jpg|jpeg|png|webp|JPG|JPEG|PNG|WEBP)$ ]] || continue

    if [[ -n "${blacklisted[$filename]}" ]]; then
        (( skipped_blacklist++ ))
        continue
    fi

    dest="$WALLPAPER_DIR/$filename"
    if [[ -f "$dest" ]]; then
        (( skipped_exists++ ))
        continue
    fi

    echo -n "  Copiando $filename ... "
    if gio copy "$MTP_PATH/$filename" "$dest"; then
        echo "ok"
        (( copied++ ))
    else
        echo "ERRO"
        (( errors++ ))
    fi
done < <(gio list "$MTP_PATH/")

echo ""
echo "----------------------------------------"
echo "  Importadas : $copied"
echo "  Ja existiam: $skipped_exists"
echo "  Ignoradas  : $skipped_blacklist  (excluidas antes)"
[[ $errors -gt 0 ]] && echo "  Erros      : $errors"
echo "----------------------------------------"
echo ""

notify-send "sync-dji" "$copied nova(s) foto(s) importada(s)" 2>/dev/null

read -rsp "Pressione Enter para fechar..." _
