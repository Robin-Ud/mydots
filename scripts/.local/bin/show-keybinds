#!/usr/bin/env python3
"""Cheatsheet de keybinds do Hyprland (Super + /) — exibe no rofi.

A lista vem do Hyprland ao vivo (`hyprctl binds -j`), não de uma tabela à mão:
bind novo aparece sozinho, bind removido some sozinho. Aqui só mora o
dicionário que traduz comando → descrição. Bind sem descrição cai em "Outros"
com o comando cru, para nunca sumir calado — é o sinal de que falta uma regra.

Enter executa o atalho escolhido (quando a linha é um bind só).
"""

import json
import re
import subprocess

# Ordem em que as seções aparecem. "Layout: <nome>" entra logo depois de Foco.
SECTIONS = ["Apps", "Ir até o app", "Sistema", "Telas & Hardware", "Foco",
            "LAYOUT", "Janelas", "Modo resize (Super + R)", "Workspaces",
            "Scratchpad", "Screenshot", "Mídia", "Outros"]

# (regex sobre o comando, seção, descrição). Primeira que casa vence.
# Grupos nomeados viram campos da descrição: {app}, {dir} …
RULES = [
    # ── layoutmsg: dependem do layout ativo ──
    (r'layoutmsg "?swapwithmaster', "LAYOUT", "Trocar janela com o master"),
    (r'layoutmsg "?focusmaster',    "LAYOUT", "Focar o master"),
    (r'layoutmsg "?cyclenext',      "LAYOUT", "Próxima janela da pilha"),
    (r'layoutmsg "?cycleprev',      "LAYOUT", "Janela anterior da pilha"),
    (r'layoutmsg "?addmaster',      "LAYOUT", "Mais um master"),
    (r'layoutmsg "?removemaster',   "LAYOUT", "Menos um master"),
    (r'layoutmsg "?orientationnext', "LAYOUT", "Girar orientação"),
    (r'layoutmsg "?orientationcycle', "LAYOUT", "Master: esquerda / centro / direita"),
    (r'layoutmsg "?mfact -',        "LAYOUT", "Encolher master"),
    (r'layoutmsg "?mfact \+',       "LAYOUT", "Crescer master"),
    (r'layoutmsg "?togglesplit',    "LAYOUT", "Alternar split H/V"),
    (r'layoutmsg "?(colresize|fit)', "LAYOUT", "Ajustar colunas"),
    (r'layoutmsg "?(?P<msg>[^"]+)', "LAYOUT", "layoutmsg {msg}"),
    (r'\bpseudo\b',                 "LAYOUT", "Pseudotile da janela"),

    # ── Apps ──
    (r'^\$?(kitty|foot|alacritty|\$term)\b(?!.*-e)', "Apps", "Terminal"),
    (r'app-goto\.sh "(?P<app>[^"]+)"', "Ir até o app", "{app} (vai até a workspace dele)"),
    (r'app-here\.sh "(?P<app>[^"]+)"', "Apps", "{app} (traz pra workspace atual)"),
    (r'^\$?(firefox|\$browser)\b',  "Apps", "Navegador"),
    (r'rofi -show drun',            "Apps", "Launcher de apps"),
    (r'rofi-rbw',                   "Apps", "Senhas (Bitwarden)"),
    (r'xournalpp',                  "Apps", "Xournal++"),
    (r'\bqgis\b',                   "Apps", "QGIS"),
    (r'(nautilus|dolphin|thunar)',  "Apps", "Gerenciador de arquivos"),

    # ── Sistema ──
    (r'killactive',                 "Sistema", "Fechar janela"),
    (r'hyprctl reload',             "Sistema", "Recarregar config"),
    (r'^exit\b|dispatch exit',      "Sistema", "Sair do Hyprland"),
    (r'show-keybinds',              "Sistema", "Este cheatsheet"),

    # ── Telas & Hardware ──
    (r'settela',                    "Telas & Hardware", "SetTela: espelhar / ligar / posicionar monitores"),
    (r'dpms on',                    "Telas & Hardware", "Religar telas (DPMS)"),
    (r'dpms off',                   "Telas & Hardware", "Desligar telas (DPMS)"),
    (r'tablet-toggle',              "Telas & Hardware", "Mesa digitalizadora: notebook ↔ HDMI"),
    (r'(mywpp|next-wallpaper)( next)?$', "Telas & Hardware", "Próximo wallpaper"),
    (r'(mywpp delete|kill-wallpaper)', "Telas & Hardware", "Remover wallpaper atual"),
    (r'sync-dji',                   "Telas & Hardware", "Sincronizar DJI"),

    # ── Foco / Janelas ──
    (r'movefocus',                  "Foco", "Mover foco"),
    (r'movewindow"?$|movewindow "', "Janelas", "Mover janela"),
    (r'^mouse movewindow',          "Janelas", "Arrastar janela"),
    (r'^mouse resizewindow',        "Janelas", "Redimensionar janela"),
    (r'fullscreen',                 "Janelas", "Tela cheia"),
    (r'togglefloating',             "Janelas", "Alternar flutuante"),
    (r'\bpin\b',                    "Janelas", "Pin (sempre visível)"),
    (r'submap "?resize',            "Janelas", "Entrar no modo resize"),
    (r'resizeactive',               "Modo resize (Super + R)", "Redimensionar"),
    (r'submap "?reset',             "Modo resize (Super + R)", "Sair do modo resize"),

    # ── Workspaces / Scratchpad ──
    (r'togglespecialworkspace',     "Scratchpad", "Mostrar / esconder scratchpad"),
    (r'movetoworkspace "?special',  "Scratchpad", "Mandar janela pro scratchpad"),
    (r'workspace "?e\+',            "Workspaces", "Próxima workspace"),
    (r'workspace "?e-',             "Workspaces", "Workspace anterior"),
    (r'movetoworkspacesilent',      "Workspaces", "Mandar janela (sem seguir)"),
    (r'movetoworkspace',            "Workspaces", "Mandar janela e ir junto"),
    (r'workspace',                  "Workspaces", "Ir para workspace"),

    # ── Screenshot ──
    (r'grim -g .*wl-copy',          "Screenshot", "Área → clipboard"),
    (r'grim -g ',                   "Screenshot", "Área → ~/Imagens"),
    (r'grim - .*wl-copy',           "Screenshot", "Tela inteira → clipboard"),
    (r'grim ',                      "Screenshot", "Tela inteira → ~/Imagens"),

    # ── Mídia ──
    (r'set-volume .*\+',            "Mídia", "Volume +"),
    (r'set-volume .*-',             "Mídia", "Volume −"),
    (r'SINK@ toggle',               "Mídia", "Silenciar áudio"),
    (r'SOURCE@ toggle',             "Mídia", "Silenciar microfone"),
    (r'brightnessctl set \+',       "Mídia", "Brilho +"),
    (r'brightnessctl set',          "Mídia", "Brilho −"),
    (r'playerctl.*play',            "Mídia", "Play / pause"),
]

# Nomes de app para app-here / app-goto (classe → nome legível)
APPS = {
    "md.obsidian.Obsidian": "Obsidian",
    "net.ankiweb.Anki": "Anki",
    "org.zotero.Zotero": "Zotero",
    "org.mozilla.firefox": "Firefox",
    "qgis": "QGIS",
}

MODS = [(64, "Super"), (4, "Ctrl"), (8, "Alt"), (1, "Shift")]

KEYS = {
    "return": "Enter", "space": "Espaço", "tab": "Tab", "escape": "Esc",
    "slash": "/", "comma": ",", "period": ".", "minus": "-", "equal": "=",
    "left": "←", "down": "↓", "up": "↑", "right": "→",
    "print": "PrtSc", "mouse:272": "arrastar LClick",
    "mouse:273": "arrastar RClick", "mouse_down": "Scroll ↓",
    "mouse_up": "Scroll ↑",
    "xf86audioraisevolume": "Vol+", "xf86audiolowervolume": "Vol−",
    "xf86audiomute": "Mute", "xf86audiomicmute": "MicMute",
    "xf86monbrightnessup": "Brilho+", "xf86monbrightnessdown": "Brilho−",
    "xf86audioplay": "Play", "xf86audionext": "Next", "xf86audioprev": "Prev",
}

# Ordem natural das teclas dentro de uma linha agrupada
KEY_ORDER = ["H", "J", "K", "L", "←", "↓", "↑", "→",
             "1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]

# Nunca executa pelo menu: sair da sessão sem querer é caro demais
NO_RUN = {"Sair do Hyprland", "Este cheatsheet"}

TRACKER = re.compile(r"^\S*track_bind\.sh '[^']*' ")


def command_of(bind):
    """Comando efetivo de um bind, sem o wrapper do UsageTracker."""
    if bind["dispatcher"] == "exec":
        return TRACKER.sub("", bind["arg"])
    if bind.get("mouse"):
        return f"mouse {bind['arg']}"
    return f"{bind['dispatcher']} {bind['arg']}".strip()


def describe(cmd):
    """(seção, descrição) do comando; cai em Outros com o comando cru."""
    for pattern, section, desc in RULES:
        m = re.search(pattern, cmd)
        if m:
            fields = {k: APPS.get(v, v) for k, v in m.groupdict().items()}
            return section, desc.format(**fields)
    short = cmd if len(cmd) <= 50 else cmd[:49] + "…"
    return "Outros", short


def key_name(key):
    name = KEYS.get(key.lower())
    if name:
        return name
    return key.upper() if len(key) == 1 else key


def mods_name(mask):
    return " + ".join(n for bit, n in MODS if mask & bit)


def join_keys(keys):
    """Junta teclas de uma linha: dígitos em sequência viram '1 … 0'."""
    keys = sorted(set(keys), key=lambda k: (KEY_ORDER.index(k)
                                            if k in KEY_ORDER else 99, k))
    digits = [k for k in keys if k.isdigit()]
    rest = [k for k in keys if not k.isdigit()]
    if len(digits) > 2:
        rest.append(f"{digits[0]} … {digits[-1]}")
    else:
        rest += digits
    return " ".join(rest)


def build_entries(binds, layout=""):
    """Agrupa binds em [(seção, combo, descrição, bind_ou_None)].

    Binds com mesma seção, descrição, modificadores e submap viram uma linha
    só (h/j/k/l + setas, 1…0). Só linha de bind único guarda o bind, para o
    Enter poder executar.
    """
    groups = {}
    for b in binds:
        section, desc = describe(command_of(b))
        if section == "LAYOUT":
            section = f"Layout: {layout}" if layout else "Layout"
        key = (section, desc, b["modmask"], b.get("submap", ""))
        groups.setdefault(key, []).append(b)

    def order(item):
        (section, desc, mask, _), members = item
        base = "LAYOUT" if section.startswith("Layout") else section
        return (SECTIONS.index(base) if base in SECTIONS else len(SECTIONS),
                min(binds.index(m) for m in members))

    entries = []
    for (section, desc, mask, _), members in sorted(groups.items(), key=order):
        keys = join_keys([key_name(m["key"]) for m in members])
        combo = " + ".join(p for p in (mods_name(mask), keys) if p)
        runnable = len(members) == 1 and desc not in NO_RUN
        entries.append((section, combo, desc, members[0] if runnable else None))
    return entries


def build_lines(entries, width=46):
    """Linhas do rofi e, em paralelo, o bind de cada linha (ou None)."""
    lines, targets = [], []
    current = None
    for section, combo, desc, bind in entries:
        if section != current:
            if lines:
                lines.append("")
                targets.append(None)
            lines.append(f"  ── {section} " + "─" * max(1, width - len(section)))
            targets.append(None)
            current = section
        mark = " " if bind else "·"
        lines.append(f"   {mark} {combo:<32}  {desc}")
        targets.append(bind)
    return lines, targets


def hyprctl_json(*args):
    out = subprocess.run(["hyprctl", "-j", *args], capture_output=True,
                         text=True, timeout=2).stdout
    return json.loads(out)


def run_bind(bind):
    if bind.get("mouse"):
        return
    subprocess.run(["hyprctl", "dispatch", bind["dispatcher"], bind["arg"]],
                   capture_output=True)


def main():
    try:
        binds = hyprctl_json("binds")
    except Exception:
        binds = []
    try:
        layout = hyprctl_json("getoption", "general:layout").get("str", "")
    except Exception:
        layout = ""

    lines, targets = build_lines(build_entries(binds, layout))
    if not lines:
        lines = ["  (hyprctl não respondeu — sem binds para mostrar)"]
    res = subprocess.run(
        [
            "rofi", "-dmenu", "-i", "-no-custom", "-format", "i",
            "-p", "⌨  Atalhos",
            "-mesg", f"layout: {layout or '?'}  ·  Enter executa  ·  "
                     "· = linha agrupada, só referência",
            "-theme-str",
            (
                "window  { width: 55%; }"
                "listview { lines: 20; }"
                "entry   { placeholder: \" Filtrar (tecla ou ação)…\"; }"
                "element-text { font: \"JetBrainsMono NF 9\"; }"
            ),
        ],
        input="\n".join(lines), capture_output=True, text=True,
    )
    choice = res.stdout.strip()
    if res.returncode == 0 and choice.isdigit() and int(choice) < len(targets):
        bind = targets[int(choice)]
        if bind:
            run_bind(bind)


if __name__ == "__main__":
    main()
