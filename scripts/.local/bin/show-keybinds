# Binds que mudam conforme o layout ativo (hyprland-<layout>.conf)
LAYOUT_KEYBINDS = {
    "dwindle": [
        ("Super + H / J / K / L",    "Mover foco (vim)"),
        ("Super + Tab",              "Focar próxima janela"),
        ("Super + E",                "Alternar split H/V"),
        ("Super + Y",                "Pseudotile da janela"),
    ],
    "master": [
        ("Super + H / J / K / L",    "Mover foco (vim)"),
        ("Super + M",                "Trocar janela com o master"),
        ("Super + U",                "Focar o master"),
        ("Super + Tab / Shift+Tab",  "Ciclar pilha (próx / ant)"),
        ("Super + , / .",            "Add / remover master"),
        ("Super + E",                "Girar orientação"),
        ("Super + Shift + M",        "Ciclo esquerda/centro/direita"),
        ("Super + - / =",            "Encolher / crescer master"),
    ],
    "scrolling": [
        ("Super + H / L",            "Coluna anterior / próxima"),
        ("Super + J / K",            "Foco dentro da coluna"),
        ("Super + M",                "Janela vira coluna própria"),
        ("Super + Shift + M",        "Juntar / separar da coluna vizinha"),
        ("Super + E / Shift + E",    "Fit visíveis / todas"),
        ("Super + , / .",            "Trocar coluna ← / →"),
        ("Super + Tab",              "Ciclar larguras de coluna"),
        ("Super + - / =",            "Encolher / crescer coluna"),
    ],
    "monocle": [
        ("Super + Tab / Shift+Tab",  "Próxima / anterior janela"),
        ("Super + J/L  ·  K/H",      "Próxima  ·  anterior janela"),
    ],
}

def current_layout():
    try:
        out = subprocess.run(
            ["hyprctl", "-j", "getoption", "general:layout"],
            capture_output=True, text=True, timeout=2,
        ).stdout
        return json.loads(out).get("str", "")
    except Exception:
        return ""

def build_lines(entries):
    lines = []
    current_section = None
    for section, combo, desc in entries:
        if section != current_section:
            if lines:
                lines.append("")
            bar = "─" * max(1, 46 - len(section))
            lines.append(f"  ── {section} {bar}")
            current_section = section
        lines.append(f"     {combo:<34}  {desc}")
    return "\n".join(lines)

def main():
    layout = current_layout()
    entries = list(KEYBINDS)
    if layout in LAYOUT_KEYBINDS:
        extra = [(f"Layout: {layout}", combo, desc)
                 for combo, desc in LAYOUT_KEYBINDS[layout]]
        # Insere logo depois da seção "Foco", junto da navegação
        idx = max(i for i, e in enumerate(entries) if e[0] == "Foco") + 1
        entries[idx:idx] = extra
    text = build_lines(entries)
    subprocess.run(
        [
            "rofi", "-dmenu", "-p", "⌨  Keybinds", "-i",
            "-no-custom",
            "-theme-str",
            (
                "window  { width: 50%; }"
                "listview { lines: 18; }"
                "entry   { placeholder: \" Filtrar…\"; }"
                "element-text { font: \"JetBrainsMono NF 9\"; }"
            ),
        ],
        input=text,
        text=True,
    )

if __name__ == "__main__":
    main()
