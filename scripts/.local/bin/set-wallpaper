#!/usr/bin/env bash
# set-wallpaper — Inicializa o hyprpaper com o próximo wallpaper da fila
#
# Chamado pelo Hyprland no boot (exec-once = set-wallpaper).
# Cada vez que o sistema inicia, avança para o próximo wallpaper da pasta,
# criando uma rotação automática a cada sessão.
#
# As imagens devem estar em: ~/Imagens/wallpapers/
# Formatos suportados: jpg, jpeg, png, webp

WALLPAPER_DIR="$HOME/Imagens/wallpapers"
CONF="$HOME/.config/hypr/hyprpaper.conf"

# Arquivo que guarda o índice do wallpaper atual entre sessões
STATE="$HOME/.local/share/hypr-wallpaper-idx"
ORDER_FILE="$HOME/.local/share/hypr-wallpaper-order"
LOCK="$HOME/.local/share/hypr-wallpaper.lock"

# Mesmo lock usado por next-wallpaper/kill-wallpaper, para não racear com
# uma troca manual disparada durante o boot
exec 9>"$LOCK"
flock 9

# Ordem embaralhada e persistida da fila (compartilhada entre os scripts).
# Só reembaralha quando o conjunto de arquivos da pasta muda.
mapfile -t current_files < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \
    \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | sort -V)
if [[ -f "$ORDER_FILE" ]] && [[ "$(printf '%s\n' "${current_files[@]}" | sort)" == "$(sort "$ORDER_FILE")" ]]; then
    mapfile -t images < "$ORDER_FILE"
else
    mapfile -t images < <(printf '%s\n' "${current_files[@]}" | shuf)
    printf '%s\n' "${images[@]}" > "$ORDER_FILE"
fi

total=${#images[@]}
[[ $total -eq 0 ]] && { echo "Nenhuma imagem em $WALLPAPER_DIR" >&2; exit 1; }

# Avança o índice (0 → 1 → 2 → ... → total-1 → 0)
idx=0
[[ -f "$STATE" ]] && idx=$(<"$STATE")
idx=$(( (idx + 1) % total ))
echo "$idx" > "$STATE"

img="${images[$idx]}"
img2="${images[$(( (idx + 1) % total ))]}"

# Gera o hyprpaper.conf pré-carregando uma imagem por monitor (diferentes entre si)
{
    printf 'preload = %s\n' "$img"
    [[ "$img2" != "$img" ]] && printf 'preload = %s\n' "$img2"
    printf 'wallpaper = eDP-1,%s\n' "$img"
    printf 'wallpaper = HDMI-A-1,%s\n' "$img2"
} > "$CONF"

# Reinicia o hyprpaper para aplicar a nova configuração.
# "9>&-" fecha o fd do lock para esse processo: como o hyprpaper é um daemon
# que continua rodando, herdar o fd mantém o flock preso pra sempre, travando
# todo next-wallpaper/kill-wallpaper futuro.
pkill -x hyprpaper 2>/dev/null
sleep 0.2
hyprpaper 9>&- &
disown
