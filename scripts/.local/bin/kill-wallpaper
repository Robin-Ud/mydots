#!/usr/bin/env bash
# kill-wallpaper — Remove o wallpaper atual da fila e avança para o próximo

WALLPAPER_DIR="$HOME/Imagens/wallpapers"
STATE="$HOME/.local/share/hypr-wallpaper-idx"
ORDER_FILE="$HOME/.local/share/hypr-wallpaper-order"
LOCK="$HOME/.local/share/hypr-wallpaper.lock"

# Mesmo lock usado por next-wallpaper/set-wallpaper
exec 9>"$LOCK"
flock 9

# Ordem embaralhada e persistida da fila (compartilhada entre os scripts).
mapfile -t current_files < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \
    \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | sort -V)
if [[ -f "$ORDER_FILE" ]] && [[ "$(printf '%s\n' "${current_files[@]}" | sort)" == "$(sort "$ORDER_FILE")" ]]; then
    mapfile -t images < "$ORDER_FILE"
else
    mapfile -t images < <(printf '%s\n' "${current_files[@]}" | shuf)
    printf '%s\n' "${images[@]}" > "$ORDER_FILE"
fi

total=${#images[@]}
[[ $total -le 1 ]] && {
    notify-send "kill-wallpaper" "Só resta um wallpaper — não é possível remover." 2>/dev/null
    exit 1
}

idx=0
[[ -f "$STATE" ]] && idx=$(<"$STATE")
current="${images[$idx]}"

# Descarrega do hyprpaper antes de deletar
hyprctl hyprpaper unload "$current" 2>/dev/null

rm -- "$current"

# Registra no blacklist do sync-dji para não reimportar
BLACKLIST="$HOME/.local/share/dji-sync/deleted.txt"
mkdir -p "$(dirname "$BLACKLIST")"
basename "$current" >> "$BLACKLIST"

# Remove a imagem deletada da ordem persistida, preservando o embaralhamento
# do restante (em vez de reordenar tudo de novo)
new_images=()
for img in "${images[@]}"; do
    [[ "$img" == "$current" ]] && continue
    new_images+=("$img")
done
images=("${new_images[@]}")
printf '%s\n' "${images[@]}" > "$ORDER_FILE"

new_total=${#images[@]}
next_idx=$(( idx % new_total ))
new_img="${images[$next_idx]}"

echo "$next_idx" > "$STATE"

hyprctl hyprpaper preload "$new_img"
for _ in $(seq 1 20); do
    hyprctl hyprpaper listloaded 2>/dev/null | grep -qF "$new_img" && break
    sleep 0.1
done
new_img2="${images[$(( (next_idx + 1) % new_total ))]}"

hyprctl hyprpaper preload "$new_img2" 2>/dev/null
hyprctl hyprpaper wallpaper "eDP-1,$new_img"
hyprctl hyprpaper wallpaper "HDMI-A-1,$new_img2" 2>/dev/null

notify-send "Wallpaper removido" "$(basename "$current")" 2>/dev/null
