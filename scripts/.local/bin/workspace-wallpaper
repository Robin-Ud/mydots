#!/usr/bin/env bash
# workspace-wallpaper — Troca o wallpaper automaticamente ao mudar de workspace
#
# Para usar: adicione ao hyprland.conf:
#   exec-once = workspace-wallpaper
#
# Imagens ordenadas pelo número de sequência DJI (campo 5 do nome de arquivo,
# ex: dji_fly_20260604_124612_0016_... → sequência 16).
# Workspace N → N-ésima imagem nessa ordem (com módulo para ciclar).
#
# O loop externo reconecta automaticamente caso o Hyprland reinicie.

WALLPAPER_DIR="$HOME/Imagens/wallpapers"

while true; do
    SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
    [[ -S "$SOCKET" ]] || { sleep 2; continue; }

    # Ordena imagens pelo número de sequência DJI (5º campo separado por _)
    mapfile -t imgs < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \
        \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) |
        sort -t_ -k5,5n)

    # Lê eventos sem subshell para que imgs[] seja acessível
    while IFS= read -r line; do
        [[ "$line" != "workspace>>"* ]] && continue
        ws="${line#workspace>>}"
        total=${#imgs[@]}
        [[ $total -eq 0 ]] && continue
        idx=$(( (ws - 1) % total ))
        img="${imgs[$idx]}"
        if [[ -n "$img" ]]; then
            img2="${imgs[$(( (idx + 1) % total ))]}"
            hyprctl hyprpaper wallpaper "eDP-1,$img" 2>/dev/null
            [[ -n "$img2" ]] && hyprctl hyprpaper wallpaper "HDMI-A-1,$img2" 2>/dev/null
        fi
    done < <(socat -U - "UNIX-CONNECT:$SOCKET" 2>/dev/null)

    sleep 1
done
