#!/usr/bin/env bash
# aba — renomeia a aba do kitty onde você está.
# Uso: aba NOME...   ex.: aba servidor     aba notas da prova
#      aba           volta ao título automático
# Atalho equivalente (com prompt): Super+Shift+R. Ver niri/aba.py.
set -euo pipefail
[[ -n "${KITTY_WINDOW_ID:-}" ]] || { echo "aba: não estou num kitty" >&2; exit 1; }
exec kitty @ set-tab-title --match "window_id:$KITTY_WINDOW_ID" -- "$*"
