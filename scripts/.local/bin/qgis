#!/bin/sh
# 1. Define a variável para corrigir o erro de Wayland/QGIS
export QT_QPA_PLATFORM=xcb

# 2. Lança o QGIS em background, silencia logs e desvincula do terminal
# O "$@" garante que se você clicar em um arquivo .qgz, ele abra no programa
nohup /usr/bin/qgis "$@" > /dev/null 2>&1 &

# 3. Dá um tempo mínimo para o processo subir antes de liberar o terminal
disown
