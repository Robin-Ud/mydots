#!/usr/bin/env bash
# Insere fotos novas no esquema numérico e gira: N → N+1, último → 1

WALLPAPER_DIR="$HOME/etc/wallpapers"

# Calcula o maior número já usado
max=0
while IFS= read -r f; do
    base=$(basename "$f")
    num="${base%%_*}"
    (( 10#$num > max )) && max=$((10#$num))
done < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f -name '[0-9]*_*' 2>/dev/null)

# Insere arquivos sem prefixo numérico no final da sequência
while IFS= read -r f; do
    base=$(basename "$f")
    [[ "$base" =~ ^[0-9]+_ ]] && continue
    max=$((max + 1))
    mv "$f" "$WALLPAPER_DIR/${max}_${base}"
done < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \
    \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \))

# Coleta todos os arquivos numerados em ordem
mapfile -t files < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f -name '[0-9]*_*' \
    | sort -t'/' -k1 | sort -V)
total=${#files[@]}
[[ $total -eq 0 ]] && exit 0

# Gira: N → N+1 (mod total), último → 1  — usa prefixo tmp_ para evitar conflitos
for f in "${files[@]}"; do
    base=$(basename "$f")
    num="${base%%_*}"
    rest="${base#*_}"
    new_num=$(( (10#$num % total) + 1 ))
    mv "$f" "$WALLPAPER_DIR/tmp_${new_num}_${rest}"
done

for f in "$WALLPAPER_DIR"/tmp_[0-9]*_*; do
    [[ -f "$f" ]] || continue
    base=$(basename "$f")
    mv "$f" "$WALLPAPER_DIR/${base#tmp_}"
done
