#!/usr/bin/env bash
# next-wallpaper — Troca para o próximo wallpaper sem reiniciar o Hyprland
#
# Ativado pelo atalho Super + W (configurado no hyprland.conf).
# Avança o índice, pré-carrega a nova imagem e aplica no monitor.
# A imagem anterior é descarregada da memória para não acumular.

WALLPAPER_DIR="$HOME/Imagens/wallpapers"

# Mesmo arquivo de índice usado pelo set-wallpaper (compartilham a fila)
STATE="$HOME/.local/share/hypr-wallpaper-idx"
ORDER_FILE="$HOME/.local/share/hypr-wallpaper-order"
LOCK="$HOME/.local/share/hypr-wallpaper.lock"

# Serializa contra next-wallpaper/kill-wallpaper/set-wallpaper: sem isso,
# apertar o atalho várias vezes rápido sobe processos concorrentes que
# racem no STATE e nas chamadas hyprctl, deixando o monitor sem wallpaper.
exec 9>"$LOCK"
flock 9

# Ordem embaralhada e persistida da fila (compartilhada entre os scripts).
# Só reembaralha quando o conjunto de arquivos da pasta muda — reembaralhar
# a cada chamada faria o índice compartilhado apontar para imagens diferentes.
mapfile -t current_files < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \
    \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | sort -V)
if [[ -f "$ORDER_FILE" ]] && [[ "$(printf '%s\n' "${current_files[@]}" | sort)" == "$(sort "$ORDER_FILE")" ]]; then
    mapfile -t images < "$ORDER_FILE"
else
    mapfile -t images < <(printf '%s\n' "${current_files[@]}" | shuf)
    printf '%s\n' "${images[@]}" > "$ORDER_FILE"
fi

total=${#images[@]}
[[ $total -eq 0 ]] && exit 1

# Lê o índice atual e guarda a imagem antiga para descarregar depois
idx=0
[[ -f "$STATE" ]] && idx=$(<"$STATE")
old_img="${images[$idx]}"

# Avança para a próxima imagem
idx=$(( (idx + 1) % total ))
echo "$idx" > "$STATE"
new_img="${images[$idx]}"

# Pré-carrega a nova imagem no hyprpaper
hyprctl hyprpaper preload "$new_img"

# Aguarda o preload terminar (até 2 segundos, checa a cada 0.1s)
for _ in $(seq 1 20); do
    hyprctl hyprpaper listloaded 2>/dev/null | grep -qF "$new_img" && break
    sleep 0.1
done

# eDP-1 = novo índice, HDMI-A-1 = índice seguinte (imagens sempre diferentes)
new_img2="${images[$(( (idx + 1) % total ))]}"

hyprctl hyprpaper preload "$new_img2" 2>/dev/null

# Aplica nos dois monitores e libera a antiga da memória
hyprctl hyprpaper wallpaper "eDP-1,$new_img"
hyprctl hyprpaper wallpaper "HDMI-A-1,$new_img2" 2>/dev/null
[[ "$old_img" != "$new_img" ]] && hyprctl hyprpaper unload "$old_img" 2>/dev/null
