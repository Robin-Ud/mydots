#!/bin/bash

# 1. Pega o nome do arquivo
arquivo="$1"

# 2. Validação: Se não digitou nada OU o arquivo não existe
if [ -z "$arquivo" ] || [ ! -f "$arquivo" ]; then
    echo "❌ Erro: Arquivo inválido ou não encontrado."
    exit 1
fi

# 3. Extrai a extensão (ex: c, py, sh)
ext="${arquivo##*.}"

echo "========================================="
echo "🚀 Executando: $arquivo"
echo "========================================="

# 4. O Seletor de Linguagens
case "$ext" in
    c)
        if gcc -Wall -Wextra "$arquivo" -o .temp_run; then
            echo -e "✅ Compilado com sucesso.\n--- Saída ---"
            ./.temp_run
            rm -f .temp_run
        else
            echo "❌ Falha na compilação. Corrija os erros acima."
        fi
        ;;
        
    py)
        echo -e "🐍 Python\n--- Saída ---"
        python3 "$arquivo"
        ;;
        
    sh)
        echo -e "🐚 Bash\n--- Saída ---"
        bash "$arquivo"
        ;;

    *)
        echo "⚠️ A extensão '.$ext' não é suportada por este script."
        ;;
esac

echo -e "\n========================================="
