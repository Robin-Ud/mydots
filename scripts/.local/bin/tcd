#!/bin/bash
# tcd — "Test, Compile, Debug"
# Compila e roda um arquivo de código diretamente do terminal.
# Uso: tcd arquivo.c   ou   tcd script.py   ou   tcd programa.sh
#
# Suportado: C (.c), Python (.py), Shell (.sh)

arquivo="$1"

if [ -z "$arquivo" ] || [ ! -f "$arquivo" ]; then
    echo "❌ Erro: informe um arquivo válido."
    echo "   Uso: tcd <arquivo>"
    exit 1
fi

# Extrai a extensão do arquivo (ex: "main.c" → "c")
ext="${arquivo##*.}"

echo "========================================="
echo "🚀 Executando: $arquivo"
echo "========================================="

case "$ext" in
    c)
        # Compila com avisos detalhados (-Wall -Wextra)
        # O binário temporário é apagado logo após rodar
        if gcc -Wall -Wextra "$arquivo" -o .temp_run; then
            echo -e "✅ Compilado com sucesso.\n--- Saída ---"
            ./.temp_run
            rm -f .temp_run
        else
            echo "❌ Falha na compilação. Corrija os erros acima."
        fi
        ;;

    py)
        echo -e "🐍 Python\n--- Saída ---"
        python3 "$arquivo"
        ;;

    sh)
        echo -e "🐚 Bash\n--- Saída ---"
        bash "$arquivo"
        ;;

    *)
        echo "⚠️  Extensão '.$ext' não é suportada."
        echo "   Suportado: .c, .py, .sh"
        ;;
esac

echo -e "\n========================================="
