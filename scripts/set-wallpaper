#!/usr/bin/env bash
# Gera hyprpaper.conf a partir de ~/etc/wallpapers/ — workspace N usa arquivo N_*

WALLPAPER_DIR="$HOME/etc/wallpapers"
CONF="$HOME/.config/hypr/hyprpaper.conf"

rotate-wallpapers

mapfile -t images < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \
    \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | sort -V)

if [[ ${#images[@]} -eq 0 ]]; then
    echo "Nenhuma imagem encontrada em $WALLPAPER_DIR" >&2
    exit 1
fi

# Wallpaper inicial: arquivo 1_* ou o primeiro disponível
initial=$(find "$WALLPAPER_DIR" -maxdepth 1 -type f -name '1_*' | head -1)
[[ -z "$initial" ]] && initial="${images[0]}"

{
    for img in "${images[@]}"; do
        echo "preload = $img"
    done
    echo ""
    echo "wallpaper = eDP-1,$initial"
} > "$CONF"

pkill -x hyprpaper 2>/dev/null
sleep 0.2
hyprpaper &
