// Infos curtas do lado do Pokémon que abre com cada terminal.
// Quem chama é ~/.config/bash/pokemon_logo.py (no .bashrc, seção 4).
// CURTO DE PROPÓSITO: a coluna do niri tem ~48 colunas, e Pokémon + infos
// precisam caber lado a lado. Se crescer algo aqui, ajuste LARGURA_INFO no .py.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "padding": { "top": 0, "right": 2 } },
  "display": { "separator": " " },
  "modules": [
    { "type": "os",       "key": "os  ", "keyColor": "cyan",    "format": "{name} {version-id}" },
    { "type": "kernel",   "key": "ker ", "keyColor": "cyan",    "format": "{release}" },
    { "type": "wm",       "key": "wm  ", "keyColor": "green",   "format": "{pretty-name}" },
    { "type": "terminal", "key": "term", "keyColor": "green",   "format": "{pretty-name}" },
    { "type": "uptime",   "key": "up  ", "keyColor": "yellow",  "format": "{days}d {hours}h {minutes}m" },
    { "type": "memory",   "key": "ram ", "keyColor": "yellow",  "format": "{used} / {total}" },
    { "type": "battery",  "key": "bat ", "keyColor": "magenta", "format": "{capacity}" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
