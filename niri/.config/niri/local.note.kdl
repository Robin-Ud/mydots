// Modelo do ThinkPad T14 — o SetNiri.sh copia pra local.kdl (fora do git).

// Escala da tela do note (o SetTela muda em tempo real e lembra por conjunto de monitores)
output "eDP-1" {
    scale 1.0
}

// Mesa digitalizadora (Wacom Intuos BT S) começa no notebook; Alt+W troca (tablet.py)
input {
    tablet {
        map-to-output "eDP-1"
    }
}
